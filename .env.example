# ─────────────────────────────────────────────────────────────────────────────
# journzey.ai environment configuration
# Copy to .env and fill in values. NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime ---------------------------------------------------------------------
NODE_ENV=development
# API port (the Vite dev server runs on 3000 and proxies /api to this port)
PORT=4000
LOG_LEVEL=info

# PostgreSQL ------------------------------------------------------------------
DATABASE_URL=postgres://journzey:journzey@localhost:5432/journzey
# Set to true for managed Postgres that requires TLS (Neon, Supabase, RDS)
DATABASE_SSL=false
# Apply migrations + reference seed automatically when the API boots (used by Docker)
RUN_MIGRATIONS_ON_START=false

# Public URLs -----------------------------------------------------------------
# Origin the browser uses for the web app (also the only allowed CORS/CSRF origin)
APP_URL=http://localhost:3000
# Public base URL of the API as seen by browsers and webhook senders (path prefix included)
API_URL=http://localhost:3000/api
# Optional comma-separated extra allowed origins
CORS_ORIGINS=
# Express "trust proxy" setting (number of hops or a CIDR list). Defaults to 1 in production.
TRUST_PROXY=

# Sessions & encryption -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=168
# 32 random bytes, base64. Encrypts broker credentials and webhook secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Google OAuth 2.0 / OpenID Connect (see README → Google OAuth configuration) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Local development only: enables a clearly labelled "Developer sign-in" that creates a local
# (non-Google) test user. The API refuses to start if this is true with NODE_ENV=production.
DEV_AUTH_BYPASS=false

# AI Coach (Anthropic Claude). Leave empty to disable AI features gracefully.
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Market data (Twelve Data). Leave empty to show clearly labelled DEMO DATA quotes.
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=

# Screenshot storage ----------------------------------------------------------
# local = filesystem under UPLOAD_DIR (development / single node)
# s3    = any S3-compatible private bucket (AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
# Custom endpoint for R2/Supabase/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Static hosting: when set, the API also serves the built web app (single-container deploys)
WEB_DIST_DIR=

# Observability ---------------------------------------------------------------
# Optional Sentry DSN for error reporting. Logs are structured JSON on stdout
# (ship them to Logtail/Datadog/etc. with your platform's log drain).
SENTRY_DSN=

# Redis -----------------------------------------------------------------------
# Not required. The current build stores sessions in PostgreSQL and rate-limits in memory.
# Reserved for a future shared rate-limit / job-queue backend.
REDIS_URL=

# Broker integrations ---------------------------------------------------------
BINANCE_API_BASE=https://api.binance.com
